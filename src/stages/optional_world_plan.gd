class_name OptionalWorldPlan
extends RefCounted
## 寄り道のワールド（O1〜O3）の計画データ（純粋なデータ。CampaignPlan._optional が読む）。
## 本人の方針（2026-11-21）: 「クリアしなくても次のところへ行けるようなオプションのワールドに関しては
## ほんとに複雑に組み合わせて難しくしてほしい」。どのステージも難しい（★）。ステージの中身は OptionalWorlds*。
##
## 開き方（docs/campaign-plan.md「寄り道のワールドの開き方」）: opened_by のステージをクリアし、さらに広場の
## 秘密の入口（庭・小島）に誰かが入ると、その発見が進行に保存され（PlayerProgress.found_secrets）、
## 寄り道の 1 つ目のポータルが開く。あとは本編と同じく、前のステージをクリアすると次が開く。
## ポータルは入口の庭（小島）の中に並べる（本編のポータルより間隔が狭い。4 m 以上）。

const IDS: PackedStringArray = ["o1", "o2", "o3"]
## 各ステージの仕掛けの組み合わせ（docs/campaign-plan.md の表に出る短い説明）
const O1_1 := "ワープで箱を能力ごと送る×遠くから押す単発×重さの板×せり上がる段×生き物"
const O1_2 := "時の鐘×戸口で閉じない扉×重さ 2 の板×箱の使い回し"
const O1_3 := "重い（重さ 4）×切り替えの扉×発射台をワープで運ぶ×鳴り続ける時の鐘×両方の扉"
const O1_4 := "工房の決まり（ジャンプ禁止）×跳ね箱と切り替えの扉×札の捨て場所×札付きの箱"
const O1_5 := "戸口×レバー×発射台の札×重い×生き物をワープで運ぶ×3 つそろう扉"
const O2_1 := "向かい風と追い風×浮くの滑空×持ち上げ＋自分のジャンプ"
const O2_2 := "風で流れる箱×重い（横風の橋・重さ 4）×重いと浮くの打ち消し×せり上がる雲の段×2 回の滑空"
const O2_3 := "滑空で降りて登り直す×強い風×重いと浮くの入れ替え×風を追い風に"
const O2_4 := "風の壁×ダッシュは床に着くまで 1 回×足場で取り戻す×滑空"
const O2_5 := "さかさ雲の全部（流れる箱・横風の橋・重いと浮く・ワープ・風の壁とダッシュ・雲の段）"
const O3_1 := "氷のすべる箱（7 手の読み合い）×札×投げるで遠くから押す×扉"
const O3_2 := "浮く筏を単発で漕ぐ×流れ×浮くの使い回し×札×生き物の筏の橋"
const O3_3 := "生き物を重しにする（回収してもとどまる）×札の順番×生き物が踏む切り替えの扉"
const O3_4 := "泳ぐと重い（かばんに入れる）×札×重さ 4×氷のすべる箱（6 手）"
const O3_5 := "温室の全部（泳ぐと重い・重さ 4・札・氷から水路へすべる筏・生き物の橋）"


static func title(id: String) -> String:
	match id:
		"o1":
			return "からくり工房"
		"o2":
			return "さかさ雲"
	return "ひみつの温室"


static func opened_by(id: String) -> String:
	match id:
		"o1":
			return StageCatalog.WINDY_ID
		"o2":
			return "w3_cloud_corridor"
	return StageCatalog.FORT_ID


## 寄り道のワールドの入口（秘密の場所の真ん中。1 つ目のポータルの位置）。
static func teaser(id: String) -> Vector3:
	return slots(id)[0][2] as Vector3


static func secret(id: String) -> String:
	match id:
		"o1":
			return "はじまりの草原の北東、鐘で開く扉の奥の庭（鐘を鳴らす・扉のブロックに W を渡す）"
		"o2":
			return "浮島の東の端から、幅 5 の空を越えた小島（跳んでから空中ダッシュ・ブーツ）"
	return "はじまりの草原の南西、札の門の奥の庭（門の札を回収して手放してから A を渡す）"


## [題, 新しい仕掛け・組み合わせ, ポータルの位置, 住む生き物] の並び（ステージの順）。
static func slots(id: String) -> Array:
	match id:
		"o1":
			return [
				["歯車の渡し", O1_1, Vector3(19.5, 0.0, -12.5), "wish"],
				["時計じかけの回廊", O1_2, Vector3(17.5, 0.0, -16.5), "kit"],
				["重さくらべの秤", O1_3, Vector3(21.5, 0.0, -16.5), "lamb"],
				["札の歯車", O1_4, Vector3(17.5, 0.0, -20.5), "bunny"],
				["大からくり", O1_5, Vector3(21.5, 0.0, -20.5), "wish"],
			]
		"o2":
			return [
				["風見の段々", O2_1, Vector3(62.5, 0.0, -48.5), "bunny"],
				["雲の筏", O2_2, Vector3(66.5, 0.0, -45.5), "lamb"],
				["落ちる島々", O2_3, Vector3(66.5, 0.0, -51.5), "kit"],
				["さかさまの塔", O2_4, Vector3(62.5, 0.0, -43.5), "wish"],
				["空の大渦", O2_5, Vector3(62.5, 0.0, -53.5), "wish"],
			]
	return [
		["氷の温室", O3_1, Vector3(-14.5, 0.0, 18.5), "bunny"],
		["水路の花壇", O3_2, Vector3(-19.5, 0.0, 17.5), "lamb"],
		["札の苗床", O3_3, Vector3(-23.5, 0.0, 20.5), "kit"],
		["凍った池", O3_4, Vector3(-19.5, 0.0, 22.5), "bunny"],
		["大温室", O3_5, Vector3(-14.5, 0.0, 22.5), "wish"],
	]
